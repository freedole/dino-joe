<?xml version="1.0" encoding="utf-8"?>
<!--
  Dino Joe - MSIX manifest za Microsoft Store.
  Identity Name, Publisher i PublisherDisplayName se prepisuju iz Partner Center-a
  (Product management > Product identity) u msix/identity.ini; CI ih ubacuje pri pakovanju.
  Version: CI uzima verziju iz taga (v1.1.0 -> 1.1.0.0).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="{IDENTITY_NAME}" Publisher="{PUBLISHER}" Version="{VERSION}" ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>Dino Joe - Desktop Pet</DisplayName>
    <PublisherDisplayName>{PUBLISHER_DISPLAY}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="sr-latn-rs" />
    <Resource Language="bs-latn-ba" />
    <Resource Language="hr-hr" />
  </Resources>

  <Applications>
    <Application Id="DinoJoe" Executable="DinoJoe.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Dino Joe"
        Description="A tiny dinosaur that lives on your desktop, tells jokes and wants to be fed."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Dino Joe" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="DinoJoe.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DinoJoeStartup" Enabled="true" DisplayName="Dino Joe" />
        </desktop:Extension>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="DinoJoe.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="dinojoe.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
